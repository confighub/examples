# Copy to .env and fill in.
#
# Register the app to get a client_id (public, not a secret). It registers in whatever
# organization your `cub` is logged into, and the app can only sign users into that one:
#   cub oauthclient create rbac-manager --redirect-uri http://localhost:5180/
VITE_OAUTH_CLIENT_ID=

# The ConfigHub instance. Defaults to https://hub.confighub.com.
VITE_CONFIGHUB_BASE_URL=https://hub.confighub.com
