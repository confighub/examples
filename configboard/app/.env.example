# Copy to .env and fill in.
#
# Register the app to get a client_id (public, not a secret):
#   cub oauthclient create configboard --redirect-uri http://localhost:5173/
VITE_OAUTH_CLIENT_ID=

# The ConfigHub instance. Defaults to https://hub.confighub.com.
VITE_CONFIGHUB_BASE_URL=https://hub.confighub.com
